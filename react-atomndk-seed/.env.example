# ============================================================
# Variables de entorno — copiar a .env y completar con los
# valores del proyecto (ver PROJECT.md). Nunca commitear .env.
# ============================================================

# ------------------------------------------------------------
# OIDC — proveedor de identidad (Authentik por defecto)
# ------------------------------------------------------------

# Issuer URI del proveedor OIDC. En Authentik debe terminar en '/'.
# Ejemplo Authentik: https://<idp>/application/o/<app-slug>/
VITE_OIDC_ISSUER_URI=https://idp.example.com/application/o/my-app/

# Client ID de la aplicación registrada en el IdP (cliente público + PKCE).
VITE_OIDC_CLIENT_ID=your-client-id

# URL pública de la app. Debe coincidir con el dev server (puerto 5151).
# Redirect URIs a registrar en el IdP para desarrollo local:
#   http://localhost:5151
#   http://localhost:5151/login        (post-logout redirect)
VITE_OIDC_PUBLIC_URL=http://localhost:5151

# ------------------------------------------------------------
# API backend
# ------------------------------------------------------------
# Base URL del backend. backendApi (src/library/api/backend-api.ts) la usa
# y adjunta el Bearer OIDC vía token.interceptor + refresh-retry.interceptor.
VITE_API_URL=http://localhost:3000

# ------------------------------------------------------------
# Mocks (opcional)
# ------------------------------------------------------------
# 'true' arranca MSW en el navegador (solo en desarrollo) con los handlers de
# src/library/mocks/handlers. Requiere public/mockServiceWorker.js (npm run msw:init).
VITE_ENABLE_MOCKS=false

# ------------------------------------------------------------
# Sentry (opcional — vacío lo deshabilita)
# ------------------------------------------------------------
VITE_SENTRY_DSN=

# ============================================================
# NOTAS sobre claims OIDC
# ============================================================
# - PKCE: la aplicación en el IdP debe tener PKCE habilitado.
# - Scope 'groups': requiere un mapping en el IdP que incluya el claim 'groups'
#   en el ID token. Se usa para mapear grupos → roles (oidc.contract.ts).
# - Scope 'permissions' (opcional): en Authentik, un property mapping puede
#   inyectar el claim application { slug, role }. Sin él, user.application es
#   undefined. Ajustar scopes en src/library/oidc/oidc-config.ts según el IdP.
