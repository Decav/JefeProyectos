# Copia este archivo como .env y completa los datos en tu propio equipo.
# No publiques ni compartas DISCORD_TOKEN.
DISCORD_TOKEN=PEGA_AQUI_EL_TOKEN_DEL_BOT
DISCORD_CLIENT_ID=ID_DE_APLICACION
DISCORD_GUILD_ID=ID_DEL_SERVIDOR_DCV_STUDIOS

# Déjalo en false al principio. Para activarlo consulta README.md.
ENABLE_MEMBER_WELCOME=false
